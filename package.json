{
  "name": "algorithm-visualizer",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @algoviz/web dev",
    "dev:tutor": "pnpm --filter @algoviz/tutor-server dev",
    "dev:all": "pnpm --parallel --filter @algoviz/web --filter @algoviz/tutor-server run dev",
    "build": "pnpm -r run typecheck && pnpm --filter @algoviz/web build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
